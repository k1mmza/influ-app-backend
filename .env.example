# Database
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=

# Encryption key for OAuth tokens stored at rest (PlatformAccount access/refresh
# tokens are encrypted with AES-256-GCM before they touch the database).
# REQUIRED before platform sync is enabled. Must be 32 bytes, hex or base64.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, the app still boots but logs a warning and cannot encrypt/decrypt
# tokens — do not enable *_SYNC_ENABLED or platform connect without it set.
ENCRYPTION_KEY=

# Server
PORT=3001

# CORS — set to your frontend URL in production (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:3000

# File uploads — Supabase Storage (buckets: public-assets, private-files).
# Backend-only: the service-role key bypasses RLS, so NEVER expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy local-disk uploads — only still read by the one-time backfill script
# (prisma/backfill-storage.ts). Remove once the backfill has run and been verified.
UPLOAD_BASE_DIR=

# Redis — use REDIS_URL (single URL) in production, or individual vars for local dev
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
YOUTUBE_API_KEY=
YOUTUBE_CONNECT_CALLBACK_URL=http://localhost:3001/auth/youtube/connect/callback

# Tracking sync (YouTube / TikTok)
# Daily @Cron jobs that write TrackingResult snapshots. Leave both OFF; set to
# "true" only as a deliberate deploy-time choice once verified.
YOUTUBE_SYNC_ENABLED=false
TIKTOK_SYNC_ENABLED=false
# Comma-separated allowlist for the manual POST /tracking/sync/youtube trigger
# (no ADMIN role exists). Empty = nobody can trigger it.
ADMIN_EMAILS=

# Swagger/OpenAPI docs at /api/docs. Pinned OFF for production; flip to "true"
# only for local development.
SWAGGER_ENABLED=false

# TikTok Login Kit v2
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Basic Display API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Platform OAuth callback (must match registered redirect URI in each platform's app settings)
PLATFORM_CONNECT_CALLBACK_URL=http://localhost:3001/auth/platform/connect/callback

# Gemini API (Smart Plan + AI analysis/search) — get from aistudio.google.com/apikey
GEMINI_API_KEY=

# Apify — TikTok & Instagram profile scraping
APIFY_API_TOKEN=

# Resend — transactional email (password-reset links). If RESEND_API_KEY is
# unset, reset emails are skipped (the endpoint still returns generic success
# and logs the recipient only, never the token). EMAIL_FROM must be a verified
# Resend sender/domain.
RESEND_API_KEY=
EMAIL_FROM=Inflique <no-reply@inflique.com>
