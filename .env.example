# Database
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=

# Server
PORT=3001

# CORS — set to your frontend URL in production (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:3000

# File uploads — set to Railway volume mount path in production (e.g. /data/uploads)
# Leave blank for local dev (defaults to ./uploads relative to cwd)
UPLOAD_BASE_DIR=

# Redis — use REDIS_URL (single URL) in production, or individual vars for local dev
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
YOUTUBE_API_KEY=
YOUTUBE_CONNECT_CALLBACK_URL=http://localhost:3001/auth/youtube/connect/callback

# TikTok Login Kit v2
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Basic Display API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Platform OAuth callback (must match registered redirect URI in each platform's app settings)
PLATFORM_CONNECT_CALLBACK_URL=http://localhost:3001/auth/platform/connect/callback

# Anthropic API (Smart Plan feature)
ANTHROPIC_API_KEY=

# Apify — TikTok & Instagram profile scraping
APIFY_API_TOKEN=
