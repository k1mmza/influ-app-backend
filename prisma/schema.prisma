// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ADMIN is provisioned out of band (prisma/scripts/promote-admin.ts) and is
// deliberately NOT self-selectable — see SELF_SELECTABLE_ROLES in
// src/auth/dto/select-role.dto.ts. Adding a value here alone would otherwise
// make it assignable via POST /auth/select-role.
enum UserRole {
  AGENCY
  BRAND
  INFLUENCER
  ADMIN
}

enum Gender {
  male
  female
  other
}

// USER & ACCOUNT MANAGEMENT
model User {
  id                   String    @id @default(uuid())
  name                 String?
  email                String    @unique
  password             String?
  oauthProvider        String?
  oauthId              String?
  role                 UserRole?
  plan                 String?
  profileCompleteness  Int       @default(0)
  isRoleSelected       Boolean   @default(false)
  avatarUrl            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isDeleted            Boolean   @default(false)

  // Profiles
  brandProfile              BrandProfile?
  agencyProfile             AgencyProfile?
  influencerProfile         InfluencerProfile?
  claimedExternalProfiles   InfluencerProfile[] @relation("ClaimedProfile")

  // User Related
  wallet           Wallet?
  sessions         Session[]
  notifications    Notification[]
  sentReviews      Review[]       @relation("ReviewsFrom")
  receivedReviews  Review[]       @relation("ReviewsTo")
  messages         Message[]
  trackingShareLinks TrackingShareLink[]
  campaignShareLinks CampaignShareLink[]
  campaignShortlists CampaignShortlist[]
  campaignShortlistShareLinks CampaignShortlistShareLink[]
  passwordResetTokens PasswordResetToken[]
}

// AUTH SESSIONS (refresh-token store for multi-account / silent-refresh)
// One row per issued refresh token. We store only a SHA-256 hash of the raw
// token (never the raw value) — refresh tokens are high-entropy random strings,
// so a fast keyed hash is safe and, unlike bcrypt, lets us look a session up by
// its hash. Rotation on /auth/refresh sets revokedAt on the old row and inserts
// a fresh one; /auth/logout sets revokedAt on the targeted row only.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// PASSWORD RESET TOKENS
// One row per issued forgot-password request. Same principle as Session above:
// we store only a SHA-256 hash of the high-entropy raw token (never the raw
// value, which lives solely in the emailed link). A token is valid only while
// usedAt is null and expiresAt is in the future; a successful reset sets usedAt
// (single-use), and issuing a new token for a user invalidates their prior ones.
// The reset action only ever acts on this row's userId — never a client-supplied id.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model BrandProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String?
  position      String?
  telephone     String?
  companyDetail String?  @db.Text
  websiteUrl    String?
  socialLinks   Json?
  updatedAt     DateTime @updatedAt

  // Relationship to ClientBrand if this brand profile is linked
  clientBrand   ClientBrand?
}

model AgencyProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String?
  position      String?
  telephone     String?
  companyDetail String?  @db.Text
  websiteUrl    String?
  socialLinks   Json?
  updatedAt     DateTime @updatedAt

  // Relationships
  clientBrands  ClientBrand[]
}

model InfluencerProfile {
  id                  String   @id @default(uuid())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                 String?  @db.Text
  gender              Gender?
  categories          Json?    // e.g. ["beauty", "lifestyle"]
  styleTags           Json?
  keywords            Json?
  hashtags            Json?
  availabilityStatus  String?
  responseRate        Float?
  avgResponseTimeHrs  Int?
  performanceScore      Float?
  qualityScore          Float?
  audienceQualityScore  Float?
  growthRate            Float?
  country             String?
  updatedAt           DateTime @updatedAt

  // Sync metadata
  syncStatus        String    @default("IDLE")  // IDLE | SYNCING
  lastSyncedAt      DateTime?
  nextRefreshAt     DateTime?

  // Rate card file (PDF or image uploaded by the influencer)
  rateCardFileUrl   String?

  // External profile (created from URL search, not self-registered)
  isExternal        Boolean   @default(false)
  externalHandle    String?

  // Claim & merge
  claimed           Boolean   @default(false)
  claimedByUserId   String?
  claimedBy         User?     @relation("ClaimedProfile", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  // Influencer Related
  platformAccounts   PlatformAccount[]
  rateCards          RateCard[]
  pastCollaborations PastCollaboration[]
  applications       CampaignApplication[]
  trackingResults    TrackingResult[]
  shortlists         Shortlist[]
  campaignShortlists CampaignShortlist[]
  conversations      Conversation[]
  payments           Payment[]
  profileEvents      ProfileEvent[]
}

model ClientBrand {
  id             String         @id @default(uuid())
  // agencyId doubles as the "managed-by agency" FK: when origin = AGENCY_MANAGED
  // this is the agency that created/owns the unclaimed brand.
  agencyId       String?
  agency         AgencyProfile? @relation(fields: [agencyId], references: [id])
  brandProfileId String?        @unique
  brandProfile   BrandProfile?  @relation(fields: [brandProfileId], references: [id])
  brandName      String
  brandContact   String?
  brandEmail     String?
  brandWebsite   String?
  logoUrl        String?
  // Provenance (bare String — matches CampaignApplication.origin, no enum):
  //   SELF_REGISTERED  brand signed up itself (linked via brandProfileId)
  //   AGENCY_MANAGED   agency created it inline; no account yet (brandProfileId null)
  origin         String         @default("SELF_REGISTERED")
  isRegistered   Boolean        @default(false)
  // TODO(claim-flow): mirror InfluencerProfile.claimed/claimedByUserId here so an
  // AGENCY_MANAGED brand can later be claimed by a real account (addition-only).
  joinedAt       DateTime       @default(now())

  // Relationships
  campaigns      Campaign[]
  shortlists     Shortlist[]
  conversations  Conversation[]
  payments       Payment[]
}

// USER RELATED
model Wallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Float    @default(0)
  pendingPayout     Float    @default(0)
  totalEarned       Float    @default(0)
  lastPaymentAmount Float?
  lastPaymentAt     DateTime?
  updatedAt         DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String   @db.Text
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// INFLUENCER RELATED
model PlatformAccount {
  id                String            @id @default(uuid())
  influencerId      String
  influencer        InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  platform          String            // tiktok, instagram, etc.
  handle            String
  displayName       String?
  avatarUrl         String?
  profileUrl        String?
  followers         Int               @default(0)
  avgViews          Int               @default(0)
  engagementRate    Float             @default(0)
  growthRate        Float             @default(0)
  isPrimary         Boolean           @default(false)
  syncedAt          DateTime          @default(now())
  spotlightVideoId       String?
  spotlightVideoTitle    String?
  spotlightThumbnailUrl  String?

  // OAuth tokens (set when influencer connects their account)
  channelId         String?
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  tokenExpiry       DateTime?

  // Set true when the tracking sync finds this connection unusable (revoked/
  // expired refresh token, or missing the video.list scope on TikTok). The UI
  // reads this to prompt the influencer to reconnect. Cleared on a good sync.
  needsReauth       Boolean   @default(false)

  // YouTube Analytics fields (populated via yt-analytics.readonly)
  watchTimeMins     Float?
  avgViewDuration   Float?
  avgViewPct        Float?
  subscribersGained Int?
  topCountries      Json?

  // Relationships
  audienceInsights AudienceInsight[]
  contentPreviews  ContentPreview[]
}

model AudienceInsight {
  id                String          @id @default(uuid())
  platformAccountId String
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  malePct           Float?
  femalePct         Float?
  ageDistribution   Json?
}

model RateCard {
  id                 String            @id @default(uuid())
  influencerId       String
  influencer         InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  pricePerPost       Float?
  pricePerVideo      Float?
  pricePerStory      Float?
  packagePrice       Float?
  packageDescription String?           @db.Text
  updatedAt          DateTime          @updatedAt
}

model SubmittedContent {
  id              String              @id @default(uuid())
  applicationId   String
  application     CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contentUrl      String
  thumbnailUrl    String?
  contentType     String?             // video, image, etc.
  // Phase 2 content metadata (static per-content facts, set once):
  //   title       — bridged from Draft.title at approval (all content, no sync)
  //   publishedAt — true on-platform publish date, captured during platform sync
  //                 (YouTube snippet.publishedAt / TikTok create_time). Null until
  //                 a sync populates it; non-synced content (e.g. Instagram) stays
  //                 null and the report falls back to the "Approved" date.
  title           String?
  publishedAt     DateTime?
  reviewStatus    String              @default("PENDING")
  revisionNote    String?             @db.Text
  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?

  // Bridge to the live Draft approval flow: an approved Draft produces exactly
  // one SubmittedContent (null for legacy/seeded rows with no originating draft).
  draftId         String?             @unique
  draft           Draft?              @relation(fields: [draftId], references: [id], onDelete: SetNull)

  // Relationships
  trackingResults TrackingResult[]
}

// REVIEWS & FEEDBACK
model ContentPreview {
  id                String          @id @default(uuid())
  platformAccountId String
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  thumbnailUrl      String?
  contentUrl        String?
  contentType       String?
  views             Int             @default(0)
  likes             Int             @default(0)
  comments          Int             @default(0)
  shares            Int             @default(0)
  postedAt          DateTime?
}

model Review {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  fromUserId String
  fromUser   User     @relation("ReviewsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReviewsTo", fields: [toUserId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
}

// CAMPAIGN MANAGEMENT
model PastCollaboration {
  id               String            @id @default(uuid())
  influencerId     String
  influencer       InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  brandName        String
  resultViews      Int?
  resultEngagement Float?
  completedAt      DateTime?
}

model Campaign {
  id             String          @id @default(uuid())
  clientBrandId  String
  clientBrand    ClientBrand     @relation(fields: [clientBrandId], references: [id])
  name           String
  objective      String?
  budget         Float?
  budgetSpent    Float           @default(0)
  coverImageUrl  String?         // uploaded campaign cover banner (served from /uploads/campaign-covers)
  briefImageUrl  String?         // reference image shown to the creator in the conversation brief (served from /uploads/brief-images) — distinct from the public coverImageUrl banner, not fed to AI generation
  visibility     String?         // PUBLIC, PRIVATE
  status         String          @default("DRAFT")
  paymentType    String?
  keyMessage     String?         @db.Text
  doAndDont      String?         @db.Text
  deliverables   String?         @db.Text
  applyDeadline  DateTime?
  submissionDate DateTime?
  reviewDate     DateTime?
  paymentDate    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  // Relationships
  requirements       CampaignRequirement[]
  applications       CampaignApplication[]
  smartPlanBriefs    SmartPlanBrief[]
  trackingResults    TrackingResult[]
  trackingShareLinks TrackingShareLink[]
  campaignShareLinks CampaignShareLink[]
  campaignShortlists          CampaignShortlist[]
  campaignShortlistShareLinks CampaignShortlistShareLink[]
  reviews            Review[]
  pastCollaborations PastCollaboration[]
  conversations      Conversation[]
  payments           Payment[]
}

model CampaignRequirement {
  id                 String   @id @default(uuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id])
  minFollowers       Int?
  minEngagementRate  Float?
  minAvgViews        Int?
  platforms          Json?
  locations          Json?
  categories         Json?
  followerTier       String?
  contentType        String?
}

model CampaignApplication {
  id           String            @id @default(uuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id])
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  // status values (bare String — no enum migration):
  //   PENDING   influencer applied, awaiting brand        (influencer-initiated)
  //   INVITED   brand invited, awaiting influencer        (brand-initiated)
  //   ACCEPTED  linked + conversation exists              (terminal accept)
  //   REJECTED  brand rejected an application
  //   DECLINED  influencer declined an invite
  status       String            @default("PENDING")
  // who initiated the row — APPLICATION (influencer applied) | INVITATION (brand invited)
  origin       String            @default("APPLICATION")
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relationships
  submittedContents SubmittedContent[]

  // One row per (campaign, influencer) — makes invite/apply find-or-create race-safe.
  @@unique([campaignId, influencerId])
}

model SmartPlanBrief {
  id              String    @id @default(uuid())
  campaignId      String?                                    // optional — brief may exist before a campaign is chosen
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  createdBy       String                                     // User ID (foreign key kept as bare String to avoid migration churn)
  requirementJson Json?
  strategy        String?   @db.Text                        // generated strategy section
  concept         String?   @db.Text                        // generated concept section
  briefBody       String?   @db.Text                        // generated creator brief section
  generatedBrief  String?   @db.Text                        // legacy — kept for backward compat
  inputMode       String?                                    // AI | MANUAL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TrackingResult {
  id                 String            @id @default(uuid())
  campaignId         String
  campaign           Campaign          @relation(fields: [campaignId], references: [id])
  influencerId       String
  influencer         InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  submittedContentId String
  submittedContent   SubmittedContent  @relation(fields: [submittedContentId], references: [id], onDelete: Cascade)
  snapshotPeriod     String?           // DAILY, WEEKLY, etc.
  views              Int               @default(0)
  likes              Int               @default(0)
  comments           Int               @default(0)
  shares             Int               @default(0)
  engagementRate     Float             @default(0)
  recordedAt         DateTime          @default(now())

  // Natural key: one snapshot per content per period per day. Sync floors
  // recordedAt to 00:00:00Z so the key is stable within a day (createdAt is not
  // tracked here — recordedAt carries the day; real write time is row insert).
  @@unique([submittedContentId, recordedAt, snapshotPeriod])
}

// A public, account-less share link for a campaign's tracking report. The random
// `token` (never the campaign id) is the URL key. Multiple links per campaign are
// allowed and each is independently revocable, so a leaked link can be killed
// without breaking others already handed out. A link is USABLE only while
// revokedAt == null AND (expiresAt == null || expiresAt > now).
model TrackingShareLink {
  id           String    @id @default(uuid())
  token        String    @unique // crypto-random URL key (base64url)
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  revokedAt    DateTime? // null = active
  expiresAt    DateTime? // finite expiry (default 90d from creation); extend by regenerating
  lastViewedAt DateTime? // best-effort last public open; cheap usage signal
  createdAt    DateTime  @default(now())

  @@index([campaignId])
}

model CampaignShareLink {
  id           String    @id @default(uuid())
  token        String    @unique // crypto-random URL key (base64url)
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  revokedAt    DateTime? // null = active
  expiresAt    DateTime? // finite expiry (default 90d from creation); extend by regenerating
  lastViewedAt DateTime? // best-effort last public open; cheap usage signal
  createdAt    DateTime  @default(now())

  @@index([campaignId])
}

model Shortlist {
  id            String            @id @default(uuid())
  clientBrandId String
  clientBrand   ClientBrand       @relation(fields: [clientBrandId], references: [id])
  influencerId  String
  influencer    InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  addedAt       DateTime          @default(now())

  @@unique([clientBrandId, influencerId])
}

// Campaign-scoped shortlist: the client-review candidate list for ONE campaign,
// distinct from the brand-global Shortlist above and from CampaignApplication
// invitations. One row per (campaign, influencer), carrying the per-influencer
// recommendation note + proposed price shown in the influencers preview.
model CampaignShortlist {
  id                 String            @id @default(uuid())
  campaignId         String
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencerId       String
  influencer         InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  recommendationNote String?           @db.Text // "why we recommend them"
  proposedPrice      Int? // proposed price in THB (integer, mirrors budget/ratePerPost convention)
  createdById        String
  createdBy          User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  addedAt            DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([campaignId, influencerId])
  @@index([campaignId])
}

// Public, account-less share link for a campaign's influencers preview. An exact
// clone of CampaignShareLink but a SEPARATE model so the influencer list (which
// exposes proposedPrice + recommendationNote) is revocable independently of the
// campaign brief share link.
model CampaignShortlistShareLink {
  id           String    @id @default(uuid())
  token        String    @unique // crypto-random URL key (base64url)
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  revokedAt    DateTime? // null = active
  expiresAt    DateTime? // finite expiry (default 90d from creation); extend by regenerating
  lastViewedAt DateTime? // best-effort last public open; cheap usage signal
  createdAt    DateTime  @default(now())

  @@index([campaignId])
}

// COMMUNICATION
model Conversation {
  id            String            @id @default(uuid())
  campaignId    String
  campaign      Campaign          @relation(fields: [campaignId], references: [id])
  clientBrandId String
  clientBrand   ClientBrand       @relation(fields: [clientBrandId], references: [id])
  influencerId  String
  influencer    InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  workPhase            String?
  brandPhaseReady      Boolean  @default(false)
  influencerPhaseReady Boolean  @default(false)
  contractUrl     String?
  briefFileUrl    String?
  paymentProofUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  messages        Message[]
  drafts          Draft[]
}

// Conversation-scoped content drafts. Created/edited by the influencer; reviewed
// (approve / request revision) by the brand/agency. See DraftsService.
model Draft {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  // DRAFT | SUBMITTED | APPROVED | REVISION_REQUESTED (bare String — no enum migration)
  status         String       @default("DRAFT")
  notes          String?      @db.Text // influencer's detail/description
  fileUrl        String?                // uploaded pdf/image via the conversations multer pipeline
  linkUrl        String?                // external link alternative (Drive/YouTube/Frame.io)
  contentType    String?                // pdf | image | video | link
  revisionNote   String?      @db.Text // brand's feedback when requesting changes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Set when this draft is approved and bridged into the tracking lineage.
  submittedContent SubmittedContent?

  @@index([conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  attachmentUrls Json?
  isRead         Boolean      @default(false)
  sentAt         DateTime     @default(now())
}

// PROFILE ACTIVITY EVENTS (for dynamic TTL calculation)
model ProfileEvent {
  id           String            @id @default(uuid())
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  type         String            // VIEW | SEARCH | SAVE | CAMPAIGN
  createdAt    DateTime          @default(now())

  @@index([influencerId, createdAt])
}

// PAYMENTS
model Payment {
  id             String            @id @default(uuid())
  campaignId     String
  campaign       Campaign          @relation(fields: [campaignId], references: [id])
  clientBrandId  String
  clientBrand    ClientBrand       @relation(fields: [clientBrandId], references: [id])
  influencerId   String
  influencer     InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  amount         Float
  paymentType    String?
  // PENDING | AWAITING_CONFIRMATION | PAID (bare String — no enum migration).
  // PAID is reachable only after the influencer confirms receipt (see PaymentsService).
  status         String            @default("PENDING")
  transactionRef String?
  proofUrl       String?           // off-platform transfer proof, uploaded by brand/agency
  confirmedAt    DateTime?         // set when the influencer confirms receipt
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
}
