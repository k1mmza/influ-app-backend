// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  AGENCY
  BRAND
  INFLUENCER
}

// USER & ACCOUNT MANAGEMENT
model User {
  id                   String    @id @default(uuid())
  name                 String?
  email                String    @unique
  password             String?
  oauthProvider        String?
  oauthId              String?
  role                 UserRole?
  plan                 String?
  profileCompleteness  Int       @default(0)
  isRoleSelected       Boolean   @default(false)
  avatarUrl            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isDeleted            Boolean   @default(false)

  // Profiles
  brandProfile              BrandProfile?
  agencyProfile             AgencyProfile?
  influencerProfile         InfluencerProfile?
  claimedExternalProfiles   InfluencerProfile[] @relation("ClaimedProfile")

  // User Related
  wallet           Wallet?
  notifications    Notification[]
  sentReviews      Review[]       @relation("ReviewsFrom")
  receivedReviews  Review[]       @relation("ReviewsTo")
  messages         Message[]
}

model BrandProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  companyName   String?
  position      String?
  telephone     String?
  companyDetail String?  @db.Text
  websiteUrl    String?
  socialLinks   Json?
  updatedAt     DateTime @updatedAt

  // Relationship to ClientBrand if this brand profile is linked
  clientBrand   ClientBrand?
}

model AgencyProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  companyName   String?
  position      String?
  telephone     String?
  companyDetail String?  @db.Text
  websiteUrl    String?
  socialLinks   Json?
  updatedAt     DateTime @updatedAt

  // Relationships
  clientBrands  ClientBrand[]
}

model InfluencerProfile {
  id                  String   @id @default(uuid())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])
  bio                 String?  @db.Text
  categories          Json?    // e.g. ["beauty", "lifestyle"]
  styleTags           Json?
  keywords            Json?
  hashtags            Json?
  availabilityStatus  String?
  responseRate        Float?
  avgResponseTimeHrs  Int?
  performanceScore      Float?
  qualityScore          Float?
  audienceQualityScore  Float?
  growthRate            Float?
  country             String?
  updatedAt           DateTime @updatedAt

  // Sync metadata
  syncStatus        String    @default("IDLE")  // IDLE | SYNCING
  lastSyncedAt      DateTime?
  nextRefreshAt     DateTime?

  // Rate card file (PDF or image uploaded by the influencer)
  rateCardFileUrl   String?

  // External profile (created from URL search, not self-registered)
  isExternal        Boolean   @default(false)
  externalHandle    String?

  // Claim & merge
  claimed           Boolean   @default(false)
  claimedByUserId   String?
  claimedBy         User?     @relation("ClaimedProfile", fields: [claimedByUserId], references: [id])

  // Influencer Related
  platformAccounts   PlatformAccount[]
  rateCards          RateCard[]
  pastCollaborations PastCollaboration[]
  applications       CampaignApplication[]
  trackingResults    TrackingResult[]
  shortlists         Shortlist[]
  conversations      Conversation[]
  payments           Payment[]
  profileEvents      ProfileEvent[]
}

model ClientBrand {
  id             String         @id @default(uuid())
  agencyId       String?
  agency         AgencyProfile? @relation(fields: [agencyId], references: [id])
  brandProfileId String?        @unique
  brandProfile   BrandProfile?  @relation(fields: [brandProfileId], references: [id])
  brandName      String
  brandContact   String?
  brandEmail     String?
  brandWebsite   String?
  isRegistered   Boolean        @default(false)
  joinedAt       DateTime       @default(now())

  // Relationships
  campaigns      Campaign[]
  shortlists     Shortlist[]
  conversations  Conversation[]
  payments       Payment[]
}

// USER RELATED
model Wallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  balance           Float    @default(0)
  pendingPayout     Float    @default(0)
  totalEarned       Float    @default(0)
  lastPaymentAmount Float?
  lastPaymentAt     DateTime?
  updatedAt         DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  title       String
  body        String   @db.Text
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// INFLUENCER RELATED
model PlatformAccount {
  id                String            @id @default(uuid())
  influencerId      String
  influencer        InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  platform          String            // tiktok, instagram, etc.
  handle            String
  displayName       String?
  avatarUrl         String?
  profileUrl        String?
  followers         Int               @default(0)
  avgViews          Int               @default(0)
  engagementRate    Float             @default(0)
  growthRate        Float             @default(0)
  isPrimary         Boolean           @default(false)
  syncedAt          DateTime          @default(now())
  spotlightVideoId       String?
  spotlightVideoTitle    String?
  spotlightThumbnailUrl  String?

  // OAuth tokens (set when influencer connects their account)
  channelId         String?
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  tokenExpiry       DateTime?

  // YouTube Analytics fields (populated via yt-analytics.readonly)
  watchTimeMins     Float?
  avgViewDuration   Float?
  avgViewPct        Float?
  subscribersGained Int?
  topCountries      Json?

  // Relationships
  audienceInsights AudienceInsight[]
  contentPreviews  ContentPreview[]
}

model AudienceInsight {
  id                String          @id @default(uuid())
  platformAccountId String
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  malePct           Float?
  femalePct         Float?
  ageDistribution   Json?
}

model RateCard {
  id                 String            @id @default(uuid())
  influencerId       String
  influencer         InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  pricePerPost       Float?
  pricePerVideo      Float?
  pricePerStory      Float?
  packagePrice       Float?
  packageDescription String?           @db.Text
  updatedAt          DateTime          @updatedAt
}

model SubmittedContent {
  id              String              @id @default(uuid())
  applicationId   String
  application     CampaignApplication @relation(fields: [applicationId], references: [id])
  contentUrl      String
  thumbnailUrl    String?
  contentType     String?             // video, image, etc.
  reviewStatus    String              @default("PENDING")
  revisionNote    String?             @db.Text
  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?

  // Relationships
  trackingResults TrackingResult[]
}

// REVIEWS & FEEDBACK
model ContentPreview {
  id                String          @id @default(uuid())
  platformAccountId String
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  thumbnailUrl      String?
  contentUrl        String?
  contentType       String?
  views             Int             @default(0)
  likes             Int             @default(0)
  comments          Int             @default(0)
  shares            Int             @default(0)
  postedAt          DateTime?
}

model Review {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  fromUserId String
  fromUser   User     @relation("ReviewsFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsTo", fields: [toUserId], references: [id])
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
}

// CAMPAIGN MANAGEMENT
model PastCollaboration {
  id               String            @id @default(uuid())
  influencerId     String
  influencer       InfluencerProfile @relation(fields: [influencerId], references: [id])
  campaignId       String?
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  brandName        String
  resultViews      Int?
  resultEngagement Float?
  completedAt      DateTime?
}

model Campaign {
  id             String          @id @default(uuid())
  clientBrandId  String
  clientBrand    ClientBrand     @relation(fields: [clientBrandId], references: [id])
  name           String
  objective      String?
  budget         Float?
  budgetSpent    Float           @default(0)
  visibility     String?         // PUBLIC, PRIVATE
  status         String          @default("DRAFT")
  paymentType    String?
  keyMessage     String?         @db.Text
  doAndDont      String?         @db.Text
  deliverables   String?         @db.Text
  applyDeadline  DateTime?
  submissionDate DateTime?
  reviewDate     DateTime?
  paymentDate    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relationships
  requirements       CampaignRequirement[]
  applications       CampaignApplication[]
  smartPlanBriefs    SmartPlanBrief[]
  trackingResults    TrackingResult[]
  reviews            Review[]
  pastCollaborations PastCollaboration[]
  conversations      Conversation[]
  payments           Payment[]
}

model CampaignRequirement {
  id                 String   @id @default(uuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id])
  minFollowers       Int?
  minEngagementRate  Float?
  minAvgViews        Int?
  platforms          Json?
  locations          Json?
  categories         Json?
  followerTier       String?
  contentType        String?
}

model CampaignApplication {
  id           String            @id @default(uuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id])
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id])
  status       String            @default("PENDING")
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relationships
  submittedContents SubmittedContent[]
}

model SmartPlanBrief {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id])
  createdBy       String   // User ID
  requirementJson Json?
  generatedBrief  String?  @db.Text
  inputMode       String?  // AI, MANUAL
  createdAt       DateTime @default(now())
}

model TrackingResult {
  id                 String            @id @default(uuid())
  campaignId         String
  campaign           Campaign          @relation(fields: [campaignId], references: [id])
  influencerId       String
  influencer         InfluencerProfile @relation(fields: [influencerId], references: [id])
  submittedContentId String
  submittedContent   SubmittedContent  @relation(fields: [submittedContentId], references: [id])
  snapshotPeriod     String?           // DAILY, WEEKLY, etc.
  views              Int               @default(0)
  likes              Int               @default(0)
  comments           Int               @default(0)
  shares             Int               @default(0)
  engagementRate     Float             @default(0)
  recordedAt         DateTime          @default(now())
}

model Shortlist {
  id            String            @id @default(uuid())
  clientBrandId String
  clientBrand   ClientBrand       @relation(fields: [clientBrandId], references: [id])
  influencerId  String
  influencer    InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  addedAt       DateTime          @default(now())
}

// COMMUNICATION
model Conversation {
  id            String            @id @default(uuid())
  campaignId    String
  campaign      Campaign          @relation(fields: [campaignId], references: [id])
  clientBrandId String
  clientBrand   ClientBrand       @relation(fields: [clientBrandId], references: [id])
  influencerId  String
  influencer    InfluencerProfile @relation(fields: [influencerId], references: [id])
  workPhase            String?
  brandPhaseReady      Boolean  @default(false)
  influencerPhaseReady Boolean  @default(false)
  contractUrl     String?
  briefFileUrl    String?
  paymentProofUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  messages        Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       @db.Text
  attachmentUrls Json?
  isRead         Boolean      @default(false)
  sentAt         DateTime     @default(now())
}

// PROFILE ACTIVITY EVENTS (for dynamic TTL calculation)
model ProfileEvent {
  id           String            @id @default(uuid())
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  type         String            // VIEW | SEARCH | SAVE | CAMPAIGN
  createdAt    DateTime          @default(now())

  @@index([influencerId, createdAt])
}

// PAYMENTS
model Payment {
  id             String            @id @default(uuid())
  campaignId     String
  campaign       Campaign          @relation(fields: [campaignId], references: [id])
  clientBrandId  String
  clientBrand    ClientBrand       @relation(fields: [clientBrandId], references: [id])
  influencerId   String
  influencer     InfluencerProfile @relation(fields: [influencerId], references: [id])
  amount         Float
  paymentType    String?
  status         String            @default("PENDING")
  transactionRef String?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
}
