{
  "info": {
    "name": "InfluApp — Brand / Agency Profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001" },
    { "key": "token",    "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register (brand test user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Returns access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Brand User\",\n  \"email\": \"brand_test_{{$randomInt}}@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "2. Select role — BRAND",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Role is BRAND', () => pm.expect(json.role).to.equal('BRAND'));",
                  "pm.test('isRoleSelected is true', () => pm.expect(json.isRoleSelected).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/select-role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"BRAND\"\n}"
            }
          }
        },
        {
          "name": "2b. Select role — AGENCY (run instead of 2 to test agency)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Role is AGENCY', () => pm.expect(json.role).to.equal('AGENCY'));",
                  "pm.test('isRoleSelected is true', () => pm.expect(json.isRoleSelected).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/select-role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"AGENCY\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "3. GET /profile — fresh profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                  "pm.test('Has email', () => pm.expect(json.email).to.be.a('string'));",
                  "pm.test('Has role', () => pm.expect(['BRAND','AGENCY']).to.include(json.role));",
                  "pm.test('profileCompleteness is number', () => pm.expect(json.profileCompleteness).to.be.a('number'));",
                  "pm.test('profile object exists', () => pm.expect(json.profile).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/profile"
          }
        },
        {
          "name": "4. PATCH /profile — update name only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Name updated', () => pm.expect(json.name).to.equal('Updated Brand Name'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Brand Name\"\n}"
            }
          }
        },
        {
          "name": "5. PATCH /profile — update brand/agency fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const p = json.profile;",
                  "pm.test('profile exists', () => pm.expect(p).to.exist);",
                  "pm.test('companyName saved', () => pm.expect(p.companyName).to.equal('InfluApp Co.'));",
                  "pm.test('position saved', () => pm.expect(p.position).to.equal('Marketing Manager'));",
                  "pm.test('telephone saved', () => pm.expect(p.telephone).to.equal('+66812345678'));",
                  "pm.test('companyDetail saved', () => pm.expect(p.companyDetail).to.be.a('string'));",
                  "pm.test('websiteUrl saved', () => pm.expect(p.websiteUrl).to.equal('https://influapp.co'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"companyName\": \"InfluApp Co.\",\n    \"position\": \"Marketing Manager\",\n    \"telephone\": \"+66812345678\",\n    \"companyDetail\": \"We connect brands with the right creators.\",\n    \"websiteUrl\": \"https://influapp.co\"\n  }\n}"
            }
          }
        },
        {
          "name": "6. PATCH /profile — update social links",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const links = json.profile?.socialLinks;",
                  "pm.test('socialLinks saved', () => pm.expect(links).to.exist);",
                  "pm.test('instagram saved', () => pm.expect(links.instagram).to.equal('@influapp'));",
                  "pm.test('linkedin saved', () => pm.expect(links.linkedin).to.equal('linkedin.com/company/influapp'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"socialLinks\": {\n      \"instagram\": \"@influapp\",\n      \"facebook\": \"facebook.com/influapp\",\n      \"linkedin\": \"linkedin.com/company/influapp\",\n      \"tiktok\": \"@influapp_official\"\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "7. PATCH /profile — partial update (one field only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('telephone updated', () => pm.expect(json.profile?.telephone).to.equal('+66899999999'));",
                  "pm.test('companyName still present (not wiped)', () => pm.expect(json.profile?.companyName).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"telephone\": \"+66899999999\"\n  }\n}"
            }
          }
        },
        {
          "name": "8. GET /profile/completeness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('profileCompleteness is number', () => pm.expect(json.profileCompleteness).to.be.a('number'));",
                  "pm.test('profileCompleteness between 0 and 100', () => {",
                  "  pm.expect(json.profileCompleteness).to.be.at.least(0);",
                  "  pm.expect(json.profileCompleteness).to.be.at.most(100);",
                  "});",
                  "pm.test('completeness increased after updates', () => pm.expect(json.profileCompleteness).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/profile/completeness"
          }
        },
        {
          "name": "9. PATCH /profile — invalid field (should be stripped)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK — whitelist strips unknown fields silently', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"companyName\": \"Valid Co.\",\n    \"hackerField\": \"should be stripped by whitelist\"\n  }\n}"
            }
          }
        },
        {
          "name": "10. GET /profile — no token (should 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/profile"
          }
        },
        {
          "name": "11. DELETE /profile — soft delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns success message', () => pm.expect(json.message).to.include('deleted'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/profile"
          }
        }
      ]
    }
  ]
}
